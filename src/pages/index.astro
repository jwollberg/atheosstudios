---
import SiteLayout from "../layouts/SiteLayout.astro";
import Sprite from "../components/Sprite.astro";

// The three games. Copy is grounded in each game's own docs:
// Grave Error  -> C:\Projects\Grave Error\LORE.md + docs\vision.md
// Elderdeep    -> C:\Projects\Elderdeep\README.md + LORE.md
// Holdout      -> C:\Projects\Tower Defense Game\docs\vision.md
// Each game is drawn as a constellation: its emblem from the sprite, plus stars at the emblem's corners.
type Star = [cx: number, cy: number, r: number];
type Label = [x: number, y: number, text: string];

const games: {
  id: string;
  num: string;
  emblem: string;
  chartLabel: string;
  genre: string;
  title: string;
  workingTitle?: boolean;
  tag: string;
  desc: string;
  facts: string[];
  status: string;
  link?: { href: string; text: string };
  stars: Star[];
  labels: Label[];
}[] = [
  {
    id: "grave-error",
    num: "I",
    emblem: "em-ge",
    chartLabel: "Γ · The Grave",
    genre: "First-person zombie survival",
    title: "Grave Error",
    tag: "You don't beat this world. You outlast it.",
    desc: "It began with a software update. The HACK program put adaptive nanobots in billions of minds, then Core Update 3.0 shipped with a fatal flaw and the dead got back up. You're a Null, one of the few the implants never took. The Hacks are whoever used to live here. They track you by sound and by smell, they slow down in daylight, and only a ruined brain keeps one down.",
    facts: ["3D, first-person", "Solo or co-op", "PC"],
    status: "Coming eventually",
    link: { href: "https://graveerrorgame.com", text: "graveerrorgame.com" },
    stars: [[38, 100, 1.3], [82, 100, 1.1], [38, 54, 1.5], [82, 54, 1.2], [60, 32, 2], [57, 52, 0.9], [56, 74, 1], [58, 100, 0.8], [94, 24, 1.7], [25, 84, 0.9], [95, 82, 0.9], [8, 100, 0.7], [112, 100, 0.7]],
    labels: [[63, 29, "α"], [97, 21, "β"], [41, 51, "γ"]],
  },
  {
    id: "elderdeep",
    num: "II",
    emblem: "em-ed",
    chartLabel: "Ε · The Deep",
    genre: "2D dig-and-build platformer",
    title: "Elderdeep",
    tag: "The deep is somewhere you walk to.",
    desc: "A cute dig-and-build game on a world that keeps going. Undercut a cliff and it comes down on you. Chop through a trunk and the tree falls over. Where water meets lava you get obsidian. Six cavern roads run underneath it all, and the towns along them are full of people who each remember what you did to them. Humans, dwarves and goblins all dig at the same speed. Only the humans have to duck.",
    facts: ["2D, endless world", "Solo or multiplayer", "PC"],
    status: "In development",
    stars: [[34, 26, 1.9], [34, 50, 1], [8, 50, 0.7], [112, 50, 0.7], [72, 50, 1.1], [88, 50, 1.1], [72, 88, 1], [88, 88, 1], [66, 96, 1.6], [30, 90, 1.2], [108, 21, 1.3], [92, 42, 0.9]],
    labels: [[37, 22, "α"], [69, 94, "β"], [111, 19, "γ"]],
  },
  {
    id: "holdout",
    num: "III",
    emblem: "em-ho",
    chartLabel: "Η · The Hold",
    genre: "Top-down survival tower defense",
    title: "Holdout",
    workingTitle: true,
    tag: "Everyone you save gets a job.",
    desc: "A few weeks into the outbreak, somewhere in rural America, you have a pistol, a knife and a day's food. The dead walk in from the edges of the map, and each one drops whatever it was carrying when it turned. The survivors you take in all have names, and they all need a post: up the watchtower, behind the sandbags, in the medic tent. Gunfire works. It also brings more of them.",
    facts: ["Top-down", "Solo or co-op", "PC"],
    status: "Early prototype",
    stars: [[60, 26, 2], [69, 19, 1], [44, 52, 1.2], [76, 52, 1.2], [48, 100, 1], [72, 100, 1], [15, 79, 0.9], [24, 77, 1.1], [33, 80, 0.8], [87, 80, 0.8], [96, 77, 1.1], [105, 79, 0.9]],
    labels: [[63, 27, "α"], [99, 74, "β"], [18, 74, "γ"]],
  },
];

const tenets = [
  { n: "Α", title: "Our own engines", text: "Every game here runs on technology we built for it." },
  { n: "Β", title: "Generated worlds", text: "Maps come from a seed, so the next one won't look like the last." },
  { n: "Γ", title: "No dates yet", text: "You'll see a date here when there's a game to go with it." },
];
---

<SiteLayout>
  <Sprite />
  <a class="skip" href="#main">Skip to content</a>

  <header class="hdr" id="hdr">
    <div class="wrap">
      <a class="brand" href="#top" aria-label="Atheos Studios home">
        <svg role="img" aria-label="Atheos Studios"><use href="#logo"></use></svg>
      </a>
      <button class="menubtn" aria-expanded="false" aria-controls="nav">Menu</button>
      <nav class="nav" id="nav" aria-label="Primary">
        <a href="#games">Games</a>
        <a href="#studio">Studio</a>
        <a class="cta" href="https://graveerrorgame.com">Grave Error ↗</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero" id="top" aria-labelledby="h1">
      <svg class="sky" id="sky" aria-hidden="true" preserveAspectRatio="xMidYMid slice" viewBox="0 0 1600 1000"></svg>

      <!-- The dial: rings after the Antikythera mechanism, turning slowly -->
      <svg class="dial" viewBox="0 0 1000 1000" aria-hidden="true">
        <defs><path id="ring" d="M500 500m-392 0a392 392 0 1 1 784 0a392 392 0 1 1-784 0"></path></defs>
        <g fill="none" stroke="currentColor">
          <circle cx="500" cy="500" r="470" stroke-opacity=".12"></circle>
          <g class="spin rev"><circle cx="500" cy="500" r="452" stroke-opacity=".22" stroke-width="10" stroke-dasharray="1.2 8.66"></circle></g>
          <circle cx="500" cy="500" r="436" stroke-opacity=".16"></circle>
          <circle cx="500" cy="500" r="356" stroke-opacity=".14"></circle>
          <g class="spin fast"><circle cx="500" cy="500" r="330" stroke-opacity=".1" stroke-width="16" stroke-dasharray="6 8.6"></circle></g>
          <circle cx="500" cy="500" r="312" stroke-opacity=".16"></circle>
          <g class="spin rev">
            <circle cx="500" cy="500" r="250" stroke-opacity=".14" stroke-dasharray="2 6"></circle>
            <circle cx="250" cy="500" r="5" fill="currentColor" fill-opacity=".55" stroke="none"></circle>
            <circle cx="750" cy="500" r="3" fill="currentColor" fill-opacity=".45" stroke="none"></circle>
          </g>
          <g class="spin">
            <circle cx="500" cy="500" r="190" stroke-opacity=".1"></circle>
            <circle cx="500" cy="310" r="4" fill="currentColor" fill-opacity=".5" stroke="none"></circle>
          </g>
          <path d="M500 20V180M500 820V980M20 500H180M820 500H980" stroke-opacity=".12"></path>
        </g>
        <g class="spin">
          <text><textPath href="#ring" textLength="2462" lengthAdjust="spacing">GRAVE ERROR · ELDERDEEP · HOLDOUT · GRAVE ERROR · ELDERDEEP · HOLDOUT · </textPath></text>
        </g>
      </svg>

      <div class="hero-copy">
        <p class="eyebrow" data-reveal>Independent game studio</p>
        <h1 id="h1" data-reveal>Games made the long way.</h1>
        <p class="lede" data-reveal>
          We write our own engines instead of licensing one, and every map is generated from scratch. That takes a
          while. Three games are in the works, and none of them has a release date yet.
        </p>
        <div class="actions" data-reveal>
          <a class="btn btn-solid" href="https://graveerrorgame.com">Grave Error <span aria-hidden="true">→</span></a>
          <a class="btn btn-ghost" href="#games">See the games</a>
        </div>
      </div>
      <a class="cue" href="#games">The games</a>
    </section>

    <section class="sec" id="games" aria-labelledby="games-h">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <div>
            <p class="eyebrow">I–III</p>
            <h2 id="games-h">In the Works</h2>
          </div>
          <p class="aside">Three games at different stages. We'll share more as each one gets closer.</p>
        </div>

        <div class="list">
          {
            games.map((g) => (
              <article class="work" id={g.id}>
                <div class="chart" data-reveal aria-hidden="true">
                  <svg class="frame" viewBox="0 0 120 120">
                    <g fill="none" stroke="currentColor" stroke-width=".25">
                      <circle cx="60" cy="60" r="59" stroke-opacity=".3" />
                      <circle cx="60" cy="60" r="56" stroke-opacity=".14" stroke-dasharray=".3 1.2" stroke-width="1.6" />
                      <ellipse cx="60" cy="60" rx="24" ry="59" stroke-opacity=".08" />
                      <ellipse cx="60" cy="60" rx="46" ry="59" stroke-opacity=".08" />
                      <path d="M1 60H119M5 40Q60 30 115 40M5 80Q60 90 115 80" stroke-opacity=".08" />
                    </g>
                  </svg>
                  <svg viewBox="-14 -12 148 148">
                    <g class="lines">
                      <use href={`#${g.emblem}`} />
                    </g>
                    <g class="stars">
                      {g.stars.map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r} />)}
                      {g.labels.map(([x, y, t]) => <text x={x} y={y}>{t}</text>)}
                    </g>
                  </svg>
                  <span class="label">{g.chartLabel}</span>
                </div>
                <div class="info" data-reveal>
                  <span class="idx">{g.num}</span>
                  <p class="eyebrow genre">{g.genre}</p>
                  <h3>
                    {g.title}
                    {g.workingTitle && <span class="wt">Working title</span>}
                  </h3>
                  <p class="tag">{g.tag}</p>
                  <p class="desc">{g.desc}</p>
                  <ul class="facts">
                    {g.facts.map((f) => <li>{f}</li>)}
                    <li class="status">{g.status}</li>
                  </ul>
                  {g.link ? (
                    <a class="more" href={g.link.href}>
                      {g.link.text} <span class="arr" aria-hidden="true">→</span>
                    </a>
                  ) : (
                    <p class="later">More to come</p>
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="sec studio" id="studio" aria-labelledby="studio-h">
      <div class="wrap">
        <div class="statement" data-reveal>
          <p class="eyebrow">The studio</p>
          <h2 id="studio-h">Why it takes a while.</h2>
          <p>
            Atheos Studios is an independent game developer. We don't license an engine. Each game runs on code we
            wrote ourselves, down to how far a gunshot carries and how long a dwarf holds a grudge. It's the slow way to
            make games, but it means each world works the way we want it to, not the way an engine expects.
          </p>
        </div>
        <ul class="tenets" data-reveal>
          {
            tenets.map((t) => (
              <li>
                <span class="n">{t.n}</span>
                <h3>{t.title}</h3>
                <p>{t.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap">
      <svg role="img" aria-label="Atheos Studios"><use href="#logo"></use></svg>
      <small>© 2026 Atheos Studios · atheosstudios.com</small>
    </div>
  </footer>

  <script is:inline>
    document.documentElement.classList.add("js");
    (function () {
      // Star field: fixed seed so every visit shows the same sky.
      var sky = document.getElementById("sky"),
        s = 7,
        NS = "http://www.w3.org/2000/svg";
      function r() {
        s = (s * 16807) % 2147483647;
        return s / 2147483647;
      }
      for (var i = 0; i < 170; i++) {
        var c = document.createElementNS(NS, "circle");
        var big = r() > 0.93;
        c.setAttribute("cx", (r() * 1600).toFixed(1));
        c.setAttribute("cy", (r() * 1000).toFixed(1));
        c.setAttribute("r", big ? (1.3 + r() * 0.9).toFixed(2) : (0.4 + r() * 0.7).toFixed(2));
        c.setAttribute("opacity", (big ? 0.55 : 0.18 + r() * 0.35).toFixed(2));
        if (r() > 0.82) {
          c.setAttribute("class", "tw");
          c.style.animationDelay = (r() * 5).toFixed(2) + "s";
        }
        sky.appendChild(c);
      }

      // Header turns solid once you scroll.
      var h = document.getElementById("hdr");
      function hs() {
        h.classList.toggle("solid", window.scrollY > 40);
      }
      hs();
      addEventListener("scroll", hs, { passive: true });

      // Phone menu.
      var b = document.querySelector(".menubtn"),
        n = document.getElementById("nav");
      b.addEventListener("click", function () {
        var o = n.classList.toggle("open");
        b.setAttribute("aria-expanded", o);
        b.textContent = o ? "Close" : "Menu";
        h.classList.add("solid");
      });
      n.querySelectorAll("a").forEach(function (a) {
        a.addEventListener("click", function () {
          n.classList.remove("open");
          b.setAttribute("aria-expanded", "false");
          b.textContent = "Menu";
        });
      });

      // Fade sections in as they scroll into view.
      var els = document.querySelectorAll("[data-reveal]");
      if (!("IntersectionObserver" in window)) {
        els.forEach(function (e) {
          e.classList.add("in");
        });
        return;
      }
      var io = new IntersectionObserver(
        function (es) {
          es.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          });
        },
        { rootMargin: "0px 0px -8% 0px" }
      );
      els.forEach(function (e) {
        io.observe(e);
      });
    })();
  </script>
</SiteLayout>
